// server/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. MODEL USER
// ==========================================
model User {
  id           String   @id @default(uuid())
  username     String
  email        String   @unique
  passwordHash String
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relasi
  ownedWorkspaces Workspace[]       @relation("OwnerRelation")
  memberships     WorkspaceMember[] // User bisa join banyak workspace
  tasks           Task[]            // Task yang di-assign ke user ini
}

// ==========================================
// 2. MODEL WORKSPACE
// ==========================================
model Workspace {
  id            String   @id @default(uuid())
  name          String
  workspaceCode String   @unique // Kode unik (misal: Z10482) untuk join
  ownerId       String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relasi
  owner    User              @relation("OwnerRelation", fields: [ownerId], references: [id])
  members  WorkspaceMember[]
  projects Project[]
  tasks    Task[] // Menampung semua task dalam workspace ini
}

// ==========================================
// 3. MODEL WORKSPACE MEMBER (PENGGANTI MODEL EMPLOYEE)
// ==========================================
// Tabel ini mencatat status user di workspace tertentu.
// User A bisa jadi "PM" di Workspace 1, tapi "Employee" di Workspace 2.
model WorkspaceMember {
  id          String   @id @default(uuid())
  workspaceId String
  userId      String
  
  // Data Kepegawaian per Workspace
  role        String   @default("Employee") // PM, Lead Design, Staff, dll.
  position    String?  // Jabatan spesifik
  department  String?  // Divisi
  isActive    Boolean  @default(true)
  joinedAt    DateTime @default(now())

  // Relasi
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Constraint: Satu user tidak boleh double di workspace yang sama
  @@unique([workspaceId, userId]) 
  @@map("workspace_members")
}

// ==========================================
// 4. MODEL PROJECT
// ==========================================
model Project {
  id              String    @id @default(uuid())
  workspaceId     String
  name            String
  allocatedBudget Decimal   @default(0) @db.Decimal(15, 2) // Untuk Payroll Logic
  status          String    @default("Active")
  startDate       DateTime?
  endDate         DateTime?
  createdAt       DateTime  @default(now())

  // Relasi
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks     Task[]
  
  @@map("projects")
}

// ==========================================
// 5. MODEL TASK (LOGIKA PERFORMANCE)
// ==========================================
model Task {
  id          String   @id @default(uuid())
  workspaceId String   // Direct link ke workspace untuk query cepat dashboard
  projectId   String
  assignedTo  String?
  
  title       String
  description String?  @db.Text
  status      Status   @default(TODO) // Menggunakan Enum

  // --- LOGIKA PERFORMANCE METRICS (Sesuai Request) ---
  
  // 1. Effort (Fibonacci: 1, 2, 3, 5, 8, 13)
  effort      Int      @default(1) 

  // 2. Value (Priority Multiplier)
  priority    Priority @default(NORMAL)

  // 3. Timeness (Dihitung manual via backend: due_date vs completed_at)
  dueDate     DateTime?
  completedAt DateTime?

  // 4. Quality (Counter revisi)
  revisionMajor    Int @default(0) // Logic: -0.1 per count
  revisionMinor    Int @default(0) // Logic: -0.05 per count
  clientComplaints Int @default(0) // Logic: -0.2 per count

  // HASIL KALKULASI
  contributionScore Decimal @default(0) @db.Decimal(10, 4)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relasi
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee    User?     @relation(fields: [assignedTo], references: [id])
  
  @@map("tasks")
}

// ==========================================
// ENUMS
// ==========================================

enum Status {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum Priority {
  URGENT // Value 1.2
  HIGH   // Value 1.1
  NORMAL // Value 1.0
  LOW    // Value 0.8
}